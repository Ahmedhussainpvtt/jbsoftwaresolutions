{
  "name": "jbsoftwaresolutions-website",
  "private": true,
  "description": "JB Software Solutions static site - SEO pipeline matches Easy Peeze / Kharch Log",
  "scripts": {
    "seo": "node seo-build.js",
    "seo:dry": "node seo-build.js --dry-run",
    "llms": "py -3 generate-llms-txt.py",
    "pages": "py -3 _build_pages.py",
